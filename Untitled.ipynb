   "source": [
    "def calculate_average(numbers):\n",
    "    if not numbers:\n",
    "        return 0.0\n",
    "\n",
    "    total = 0\n",
    "    for number in numbers:\n",
    "        total += number\n",
    "\n",
    "    return total / len(numbers)\n",
    "print(calculate_average([10, 20, 30, 40]))\n",
    "print(calculate_average([]))"
   ]
