    "def calculate_average(numbers):\n",
    "    total = sum(numbers)\n",
    "    return total / len(numbers)\n",
    "\n",
    "\n",
    "scores = [78, 85, 92, 66, 88]\n",
    "average = calculate_average(scores)\n",
    "print(\"平均分：\", average)"
