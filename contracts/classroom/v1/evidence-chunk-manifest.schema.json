{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom.local/contracts/v1/evidence-chunk-manifest.schema.json",
  "title": "Classroom evidence chunk manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "sequence",
    "content_sha256",
    "content_encoding",
    "media_type",
    "compressed_bytes",
    "uncompressed_bytes",
    "first_event_sequence",
    "last_event_sequence",
    "object_key",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/uuid"},
    "sequence": {"type": "integer", "minimum": 1},
    "content_sha256": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/sha256"},
    "content_encoding": {"const": "gzip"},
    "media_type": {"const": "application/json"},
    "compressed_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
    "uncompressed_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
    "first_event_sequence": {"type": "integer", "minimum": 1},
    "last_event_sequence": {"type": "integer", "minimum": 1},
    "object_key": {"type": "string", "pattern": "^classrooms/[0-9a-z-]+/sessions/[0-9a-z-]+/chunks/[0-9]{8}-[0-9a-f]{64}\\.json\\.gz$"},
    "created_at": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/timestamp"}
  }
}
