{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom.local/contracts/v1/plan-draft.schema.json",
  "title": "Classroom plan draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_id",
    "space_id",
    "parent_algorithm_id",
    "title",
    "profile",
    "scheduled_start_at",
    "scheduled_end_at",
    "ai_policy",
    "revision",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "draft_id": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/uuid"},
    "space_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "parent_algorithm_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "profile": {
      "$ref": "https://classroom.local/plugin/api-schemas/profile-draft-v2.json"
    },
    "scheduled_start_at": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/timestamp"},
    "scheduled_end_at": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/timestamp"},
    "ai_policy": {"enum": ["prohibited", "allowed"]},
    "revision": {"type": "integer", "minimum": 0},
    "updated_at": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/timestamp"}
  }
}
