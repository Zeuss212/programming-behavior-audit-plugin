{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom.local/contracts/v1/student-brief.schema.json",
  "title": "Student classroom brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "session_id",
    "assignment_id",
    "plan_id",
    "plan_version",
    "revision",
    "status",
    "data_completeness",
    "submission_reason",
    "submitted_at",
    "evidence_cutoff_at",
    "active_duration_ms",
    "summary",
    "knowledge_points",
    "process_overview",
    "issues",
    "ai_analysis_status",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "brief_id": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/uuid"},
    "session_id": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/uuid"},
    "assignment_id": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/uuid"},
    "plan_id": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/uuid"},
    "plan_version": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["completed", "partial"]},
    "data_completeness": {"enum": ["complete", "partial"]},
    "submission_reason": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/submission_reason"},
    "submitted_at": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/timestamp"},
    "evidence_cutoff_at": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/timestamp"},
    "active_duration_ms": {"type": "integer", "minimum": 0},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "knowledge_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_point_id",
          "name",
          "status",
          "evidence_refs",
          "demonstrated",
          "gap",
          "teacher_suggestion"
        ],
        "properties": {
          "knowledge_point_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "status": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/mastery_status"},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/evidence_ref"}
          },
          "demonstrated": {"type": "string", "minLength": 1, "maxLength": 1000},
          "gap": {"type": "string", "minLength": 1, "maxLength": 1000},
          "teacher_suggestion": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "process_overview": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "issues": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "ai_analysis_status": {"enum": ["not_requested", "pending", "ready", "unavailable"]},
    "ai_analysis": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "knowledge_point_analyses",
        "teacher_note"
      ],
      "properties": {
        "knowledge_point_analyses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "knowledge_point_id",
              "status",
              "evidence_event_ids",
              "teaching_suggestion"
            ],
            "properties": {
              "knowledge_point_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "status": {
                "enum": ["observed", "partial", "not_observed", "teacher_review_required"]
              },
              "evidence_event_ids": {
                "type": "array",
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^chunk-[1-9][0-9]*#event-[1-9][0-9]*$"
                }
              },
              "teaching_suggestion": {"type": "string", "minLength": 1, "maxLength": 500}
            },
            "allOf": [
              {
                "if": {"properties": {"status": {"const": "not_observed"}}},
                "then": {"properties": {"evidence_event_ids": {"maxItems": 0}}},
                "else": {"properties": {"evidence_event_ids": {"minItems": 1}}}
              }
            ]
          }
        },
        "teacher_note": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "assessment_score": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schema_version", "scoring_rule_version", "overall_score", "dimensions"],
      "properties": {
        "schema_version": {"const": 1},
        "scoring_rule_version": {"const": "ai-score-v1"},
        "overall_score": {"type": "number", "minimum": 0, "maximum": 100},
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension_id",
              "dimension_name",
              "score",
              "weight_bps",
              "weighted_score",
              "evidence_level",
              "confidence",
              "reason",
              "evidence_event_ids"
            ],
            "properties": {
              "dimension_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "dimension_name": {"type": "string", "minLength": 1, "maxLength": 50},
              "score": {"type": "integer", "minimum": 0, "maximum": 100},
              "weight_bps": {"type": "integer", "minimum": 1, "maximum": 10000},
              "weighted_score": {"type": "number", "minimum": 0, "maximum": 100},
              "evidence_level": {"enum": ["sufficient", "partial", "insufficient"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "reason": {"type": "string", "minLength": 1, "maxLength": 500},
              "evidence_event_ids": {
                "type": "array",
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^chunk-[1-9][0-9]*#event-[1-9][0-9]*$"
                }
              }
            },
            "allOf": [
              {
                "if": {"properties": {"evidence_level": {"const": "partial"}}},
                "then": {"properties": {"score": {"maximum": 79}}}
              },
              {
                "if": {"properties": {"evidence_level": {"const": "insufficient"}}},
                "then": {"properties": {"score": {"maximum": 59}}},
                "else": {"properties": {"evidence_event_ids": {"minItems": 1}}}
              }
            ]
          }
        }
      }
    },
    "generated_at": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/timestamp"}
  }
}
