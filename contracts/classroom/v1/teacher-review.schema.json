{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom.local/contracts/v1/teacher-review.schema.json",
  "title": "Teacher classroom brief review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "session_id",
    "teacher_id",
    "knowledge_point_reviews",
    "comment",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "review_id": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/uuid"},
    "session_id": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/uuid"},
    "teacher_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "knowledge_point_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["knowledge_point_id", "status", "reason"],
        "properties": {
          "knowledge_point_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/mastery_status"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "comment": {"type": "string", "maxLength": 2000},
    "created_at": {"$ref": "https://classroom.local/contracts/v1/common.schema.json#/$defs/timestamp"}
  }
}
