# myextension 0.3.0 课堂镜像的非密钥运行配置。
JUPYTERLAB_BEHAVIOR_AUDIT_LOG_DIR=/workspace/result/behavior-audit

# 教学演示镜像：学生 5 分钟无心跳后自动结束并生成 partial 简报。
# 普通单用户镜像如不需要此策略，应删除该变量，代码默认值为 1800 秒。
JUPYTERLAB_BEHAVIOR_AUDIT_STALE_SESSION_TIMEOUT_SEC=300

JUPYTERLAB_BEHAVIOR_AUDIT_ANALYSIS_TIMEOUT_SEC=180
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=glm-5-2-260617

# ARK_API_KEY 故意不放在本文件中。必须由平台 Secret 在运行时注入。
