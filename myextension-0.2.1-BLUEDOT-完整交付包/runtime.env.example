# Non-secret runtime configuration for myextension 0.2.1.
JUPYTERLAB_BEHAVIOR_AUDIT_LOG_DIR=/workspace/result/behavior-audit
JUPYTERLAB_BEHAVIOR_AUDIT_ANALYSIS_TIMEOUT_SEC=120
# Authoring suggestions use internal 2048/4096 JSON requests with thinking
# disabled. Whole-session analysis keeps its separate 120-second budget.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=glm-5-2-260617

# ARK_API_KEY is intentionally absent. Inject it from the platform secret
# manager at runtime; never place it in this file, the Dockerfile, or the image.
