{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session segment batch v1",
  "description": "The registry validates sequence ordering and inclusive-range length after this portable JSON Schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "segment_id", "first_sequence", "last_sequence", "content_hash", "segments"],
  "properties": {
    "schema_version": {"const": 1},
    "segment_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "first_sequence": {"type": "integer", "minimum": 1},
    "last_sequence": {"type": "integer", "minimum": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "segments": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/segment"}}
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_seq", "event_id", "segment_type", "started_at", "ended_at", "duration_ms"],
      "properties": {
        "session_seq": {"type": "integer", "minimum": 1},
        "event_id": {"type": "string", "minLength": 1},
        "segment_type": {
          "type": "string",
          "enum": ["code_writing", "code_deletion", "code_paste", "code_execution", "idle", "page_away", "cell_switch", "notebook_switch", "kernel_restart"]
        },
        "started_at": {"type": "string", "minLength": 1},
        "ended_at": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "integer", "minimum": 0},
        "inserted_char_count": {"type": "integer", "minimum": 0},
        "deleted_char_count": {"type": "integer", "minimum": 0},
        "paste_char_count": {"type": "integer", "minimum": 0},
        "cell_source": {"type": "string"},
        "execution_result": {"type": "string", "enum": ["success", "failure"]},
        "error_type": {"type": "string"},
        "error_message": {"type": "string"},
        "deleted_content": {"type": "string"},
        "thinking_of": {"type": "string"},
        "previous_cell_index": {"type": "integer", "minimum": 0},
        "next_cell_index": {"type": "integer", "minimum": 0},
        "previous_notebook_path": {"type": "string"},
        "next_notebook_path": {"type": "string"},
        "kernel_status": {"type": "string"},
        "deleted_is_full_line": {"type": "boolean"},
        "had_paste": {"type": "boolean"},
        "document_type": {"type": "string", "enum": ["notebook_cell", "python_file"]},
        "file_path": {"type": "string"},
        "file_name": {"type": "string"},
        "notebook_path": {"type": "string"},
        "notebook_id": {"type": "string"},
        "cell_id": {"type": "string"},
        "cell_index": {"type": "integer", "minimum": 0},
        "cell_type": {"type": "string"}
      }
    }
  }
}
