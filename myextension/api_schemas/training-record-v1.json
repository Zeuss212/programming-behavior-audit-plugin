{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private-safe reproducible training record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session", "problem_profile", "code_snapshots", "behavior_events", "ai_analysis", "teacher_reviews", "integrity", "export"],
  "properties": {
    "schema_version": {"const": 1},
    "session": {"$ref": "#/$defs/session_summary"},
    "problem_profile": {"$ref": "#/$defs/problem_profile"},
    "code_snapshots": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/code_snapshot"}},
    "behavior_events": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/event"}},
    "ai_analysis": {"type": ["null", "object"], "allOf": [{"if": {"type": "object"}, "then": {"$ref": "#/$defs/analysis"}}]},
    "teacher_reviews": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/review"}},
    "integrity": {"$ref": "#/$defs/integrity"},
    "export": {"$ref": "#/$defs/export_metadata"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string": {"type": "string", "minLength": 1, "maxLength": 10000},
    "nullable_string": {"type": ["string", "null"], "maxLength": 10000},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[1-9][0-9]*$"},
    "session_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "problem_id", "problem_title", "profile_id", "profile_version", "status", "started_at", "ended_at", "analysis_job_id", "analysis_status", "review_count", "event_count"],
      "properties": {
        "session_id": {"$ref": "#/$defs/uuid"}, "problem_id": {"$ref": "#/$defs/string"}, "problem_title": {"$ref": "#/$defs/string"}, "profile_id": {"$ref": "#/$defs/uuid"}, "profile_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "status": {"enum": ["collecting", "finalizing", "finalized", "abandoned"]}, "started_at": {"$ref": "#/$defs/string"}, "ended_at": {"$ref": "#/$defs/nullable_string"}, "analysis_job_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}, "analysis_status": {"enum": ["queued", "running", "ready", "partial", "error", null]}, "review_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 10000}, "event_count": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "problem_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "profile_id", "version", "problem_id", "title", "dimensions", "content_hash"],
      "properties": {"schema_version": {"enum": [1, 2]}, "profile_id": {"$ref": "#/$defs/uuid"}, "version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "problem_id": {"$ref": "#/$defs/string"}, "title": {"type": "string", "minLength": 1, "maxLength": 200}, "dimensions": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/profile_dimension"}}, "knowledge_points": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/object"}}, "content_hash": {"$ref": "#/$defs/hash"}}
    },
    "profile_dimension": {"type": "object", "additionalProperties": false, "required": ["code", "name", "question", "evidence_criteria", "levels", "analysis_config"], "properties": {"knowledge_point_id": {"type": "string", "pattern": "^KP_[A-Z0-9]{8}$"}, "code": {"$ref": "#/$defs/string"}, "name": {"type": "string", "minLength": 1, "maxLength": 50}, "question": {"type": "string", "minLength": 1, "maxLength": 200}, "no_known_exclusion": {"type": "boolean"}, "evidence_criteria": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/object"}}, "levels": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/object"}}, "teaching_actions": {"$ref": "#/$defs/object"}, "analysis_config": {"$ref": "#/$defs/object"}}},
    "object": {"type": "object", "additionalProperties": false, "maxProperties": 30, "properties": {"id": {"$ref": "#/$defs/string"}, "code": {"$ref": "#/$defs/string"}, "name": {"$ref": "#/$defs/string"}, "description": {"type": "string", "maxLength": 10000}, "statement": {"type": "string", "maxLength": 10000}, "question": {"type": "string", "maxLength": 10000}, "definition": {"type": "string", "maxLength": 10000}, "direction": {"enum": ["support", "exclude"]}, "possible": {"type": "string", "maxLength": 500}, "clear": {"type": "string", "maxLength": 500}, "not_observed": {"type": "string", "maxLength": 500}, "mode": {"const": "llm_evidence"}, "minimum_observation": {"$ref": "#/$defs/minimum_observation"}, "valid_observation_duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}, "edit_event_count": {"type": "integer", "minimum": 0, "maximum": 10000}, "run_count": {"type": "integer", "minimum": 0, "maximum": 10000}, "status": {"$ref": "#/$defs/string"}, "final_evidence_status": {"enum": ["observed", "not_observed", "insufficient_evidence", "not_computable", null]}, "final_level_code": {"enum": ["possible", "clear", null]}, "display_label": {"$ref": "#/$defs/string"}, "source": {"$ref": "#/$defs/string"}, "order": {"type": "integer", "minimum": 0, "maximum": 10000}, "missing_required_signals": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/string"}}, "observation_opportunities": {"type": "integer", "minimum": 0, "maximum": 10000}, "reason_code": {"$ref": "#/$defs/nullable_string"}, "reason": {"$ref": "#/$defs/nullable_string"}, "missing_optional_signals": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/string"}}, "revision": {"type": "integer", "minimum": 0, "maximum": 10000}}},
    "minimum_observation": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"valid_observation_duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}, "edit_event_count": {"type": "integer", "minimum": 0, "maximum": 10000}, "run_count": {"type": "integer", "minimum": 0, "maximum": 10000}}},
    "event": {"type": "object", "additionalProperties": false, "required": ["event_id", "session_seq", "segment_type", "started_at", "ended_at", "duration_ms"], "properties": {"event_id": {"$ref": "#/$defs/event_id"}, "session_seq": {"type": "integer", "minimum": 1, "maximum": 10000}, "segment_type": {"$ref": "#/$defs/string"}, "started_at": {"$ref": "#/$defs/string"}, "ended_at": {"$ref": "#/$defs/string"}, "duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}, "inserted_char_count": {"type": "integer", "minimum": 0, "maximum": 1000000}, "deleted_char_count": {"type": "integer", "minimum": 0, "maximum": 1000000}, "paste_char_count": {"type": "integer", "minimum": 0, "maximum": 1000000}, "cell_source": {"type": "string", "maxLength": 100000}, "execution_result": {"$ref": "#/$defs/string"}, "error_type": {"$ref": "#/$defs/string"}, "error_message": {"type": "string", "maxLength": 10000}, "deleted_content": {"type": "string", "maxLength": 100000}, "deleted_is_full_line": {"type": "boolean"}, "had_paste": {"type": "boolean"}, "document_type": {"$ref": "#/$defs/string"}, "file_name": {"$ref": "#/$defs/string"}, "notebook_id": {"$ref": "#/$defs/string"}, "cell_id": {"$ref": "#/$defs/string"}, "cell_index": {"type": "integer", "minimum": 0, "maximum": 1000000}, "cell_type": {"$ref": "#/$defs/string"}, "document_name": {"$ref": "#/$defs/string"}, "referenced_by_dimensions": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/string"}}}},
    "code_snapshot": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "event_ids", "first_session_seq", "last_session_seq", "started_at", "ended_at", "source", "document_type", "document_name", "cell_id", "cell_index", "execution_result", "error_type", "error_message"], "properties": {"snapshot_id": {"$ref": "#/$defs/hash"}, "event_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/event_id"}}, "first_session_seq": {"type": "integer", "minimum": 1, "maximum": 10000}, "last_session_seq": {"type": "integer", "minimum": 1, "maximum": 10000}, "started_at": {"$ref": "#/$defs/string"}, "ended_at": {"$ref": "#/$defs/string"}, "source": {"type": "string", "maxLength": 100000}, "document_type": {"$ref": "#/$defs/nullable_string"}, "document_name": {"$ref": "#/$defs/nullable_string"}, "cell_id": {"$ref": "#/$defs/nullable_string"}, "cell_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000}, "execution_result": {"$ref": "#/$defs/nullable_string"}, "error_type": {"$ref": "#/$defs/nullable_string"}, "error_message": {"$ref": "#/$defs/nullable_string"}}},
    "analysis": {"type": "object", "additionalProperties": false, "required": ["schema_version", "analysis_id", "job_id", "attempt_id", "session_id", "profile_id", "profile_version", "profile_content_hash", "status", "dimension_results", "provenance"], "properties": {"schema_version": {"const": 1}, "analysis_id": {"$ref": "#/$defs/uuid"}, "job_id": {"$ref": "#/$defs/uuid"}, "attempt_id": {"$ref": "#/$defs/uuid"}, "session_id": {"$ref": "#/$defs/uuid"}, "profile_id": {"$ref": "#/$defs/uuid"}, "profile_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "profile_content_hash": {"$ref": "#/$defs/hash"}, "status": {"enum": ["ready", "partial"]}, "dimension_results": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/dimension_result"}}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "dimension_result": {"type": "object", "additionalProperties": false, "required": ["schema_version", "dimension_code", "decision"], "properties": {"schema_version": {"const": 1}, "dimension_code": {"$ref": "#/$defs/string"}, "decision": {"$ref": "#/$defs/object"}, "data_quality": {"$ref": "#/$defs/object"}, "ai_result": {"type": ["object", "null"], "additionalProperties": false, "required": ["confidence", "evidence_claims", "explanation"], "properties": {"confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_claims": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/evidence_claim"}}, "explanation": {"type": "string", "maxLength": 500}}}, "review": {"$ref": "#/$defs/object"}}},
    "evidence_claim": {"type": "object", "additionalProperties": false, "required": ["event_id", "criterion_id", "direction", "claim"], "properties": {"event_id": {"$ref": "#/$defs/event_id"}, "criterion_id": {"$ref": "#/$defs/string"}, "direction": {"enum": ["support", "exclude"]}, "claim": {"type": "string", "minLength": 1, "maxLength": 500}, "occurred_at": {"$ref": "#/$defs/string"}, "event_type": {"$ref": "#/$defs/string"}}},
    "provenance": {"type": "object", "additionalProperties": false, "properties": {"analysis_pipeline_version": {"$ref": "#/$defs/string"}, "feature_extractor_version": {"$ref": "#/$defs/string"}, "signal_dictionary_version": {"$ref": "#/$defs/string"}, "signal_dictionary_hash": {"$ref": "#/$defs/hash"}, "model_name": {"$ref": "#/$defs/string"}, "model_version": {"$ref": "#/$defs/nullable_string"}, "model_parameters": {"type": "object", "additionalProperties": false, "required": ["temperature"], "properties": {"temperature": {"type": "number", "const": 0}}}, "prompt_version": {"$ref": "#/$defs/string"}, "prompt_content_hash": {"$ref": "#/$defs/hash"}, "raw_response_hash": {"$ref": "#/$defs/hash"}, "input_snapshot_hash": {"$ref": "#/$defs/hash"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["schema_version", "analysis_id", "dimension_code", "reason_code", "comment", "decision_status", "level_code", "revision", "evidence_status", "evidence_event_ids", "reviewed_at"], "properties": {"schema_version": {"const": 1}, "analysis_id": {"$ref": "#/$defs/uuid"}, "dimension_code": {"$ref": "#/$defs/string"}, "reason_code": {"$ref": "#/$defs/string"}, "comment": {"type": "string", "maxLength": 2000}, "decision_status": {"$ref": "#/$defs/string"}, "level_code": {"type": ["string", "null"], "maxLength": 100}, "revision": {"type": "integer", "minimum": 1, "maximum": 10000}, "evidence_status": {"$ref": "#/$defs/string"}, "evidence_event_ids": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/review_evidence_id"}}, "reviewed_at": {"$ref": "#/$defs/string"}}},
    "review_evidence_id": {"type": "string", "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[1-9][0-9]*|[A-Za-z0-9][A-Za-z0-9._:-]{0,199})$"},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["complete", "missing_artifacts", "warnings"], "properties": {"complete": {"type": "boolean"}, "missing_artifacts": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/string"}}, "warnings": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 200}}}},
    "export_metadata": {"type": "object", "additionalProperties": false, "required": ["schema_version", "generated_at", "source_session_id", "source_state_hash", "content_hash"], "properties": {"schema_version": {"const": 1}, "generated_at": {"$ref": "#/$defs/string"}, "source_session_id": {"$ref": "#/$defs/uuid"}, "source_state_hash": {"$ref": "#/$defs/hash"}, "content_hash": {"$ref": "#/$defs/hash"}}}
  }
}
