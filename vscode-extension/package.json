{
  "name": "behavior-audit-vscode",
  "displayName": "编程行为分析",
  "description": "面向课堂演示的本地编程行为采集与简报扩展。",
  "publisher": "bluedot-ai",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "categories": [
    "Education"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "extensionPack": [
    "ms-python.python"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited"
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "behaviorAudit.pasteAndRecord",
        "title": "编程行为分析: 粘贴并记录摘要"
      }
    ],
    "keybindings": [
      {
        "command": "behaviorAudit.pasteAndRecord",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "behaviorAudit.collecting && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:integration": "npm run build && npm run compile:test && node dist-test/test/integration/runTest.js",
    "test": "npm run test:unit",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "package": "npm run verify && vsce package --out behavior-audit-vscode-0.1.0.vsix"
  },
  "dependencies": {
    "@vscode/python-extension": "1.0.6",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "mocha": "11.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
