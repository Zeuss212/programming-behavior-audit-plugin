{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluedot-ai.example/schemas/behavior-audit/ai-plan-suggestion-v1.schema.json",
  "title": "Behavior Audit AI Plan Suggestion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "knowledge_points", "tests"],
  "properties": {
    "schema_version": { "const": 1 },
    "knowledge_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "observation_basis"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "observation_basis": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "expected_behavior"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "expected_behavior": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
